/* =========================
   25. MYSQL TIME FUNCTIONS
   =========================
   DEF: Work with time values
   WHEN: Get, extract, compare, or calculate time
   WHERE: Attendance, orders, logs, appointments


   CURTIME()
   DEF: Returns current time

   INPUT: SELECT CURTIME();

   OUTPUT: 10:30:00
   REAL: Get current time


   TIME()
   DEF: Extracts time from a DATETIME value

   INPUT: SELECT TIME('2026-09-27 10:30:45');

   OUTPUT: 10:30:45
   REAL: Extract time from an order timestamp


   HOUR()
   DEF: Extracts the hour from a time

   INPUT: SELECT HOUR('10:30:45');

   OUTPUT: 10
   REAL: Find the hour of an order/login


   MINUTE()
   DEF: Extracts the minute from a time

   INPUT: SELECT MINUTE('10:30:45');

   OUTPUT: 30
   REAL: Analyze time-based records


   SECOND()
   DEF: Extracts the seconds from a time

   INPUT: SELECT SECOND('10:30:45');

   OUTPUT: 45
   REAL: Get seconds from a timestamp


   ADDTIME()
   DEF: Adds a time interval to a time

   INPUT: SELECT ADDTIME('10:30:00', '02:15:00');

   OUTPUT: 12:45:00
   REAL: Add duration to a time


   SUBTIME()
   DEF: Subtracts a time interval from a time

   INPUT: SELECT SUBTIME('10:30:00', '02:15:00');

   OUTPUT: 08:15:00
   REAL: Calculate an earlier time


   TIMEDIFF()
   DEF: Returns the difference between two times

   INPUT: SELECT TIMEDIFF('18:30:00', '10:30:00');

   OUTPUT: 08:00:00
   REAL: Calculate working/session duration


   IMPORTANT:

   CURTIME() → Current time
   TIME()    → Extract time
   HOUR()    → Hour
   MINUTE()  → Minute
   SECOND()  → Second
   ADDTIME() → Add time
   SUBTIME() → Subtract time
   TIMEDIFF() → Difference between times
*/
/* =========================
   26. ALTER / DROP

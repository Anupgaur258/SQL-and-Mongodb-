/* =========================
   24. MYSQL STRING FUNCTIONS
   =========================
   DEF: Work with and manipulate text/string data
   WHEN: Search, format, combine, or modify text
   WHERE: Names, emails, addresses, reports, data cleaning


   CONCAT()
   DEF: Combines two or more strings

   INPUT: SELECT CONCAT(first_name, ' ', last_name) AS full_name
          FROM student;

   OUTPUT: Full name
   REAL: Combine first and last name


   UPPER()
   DEF: Converts text to uppercase

   INPUT: SELECT UPPER(name) FROM student;

   OUTPUT: ANUP
   REAL: Convert names to uppercase


   LOWER()
   DEF: Converts text to lowercase

   INPUT: SELECT LOWER(name) FROM student;

   OUTPUT: anup
   REAL: Convert email/name to lowercase


   LENGTH()
   DEF: Returns the length of a string

   INPUT: SELECT LENGTH(name) FROM student;

   OUTPUT: Number of characters/bytes
   REAL: Check length of username or text


   SUBSTRING()
   DEF: Extracts a part of a string

   INPUT: SELECT SUBSTRING(name, 1, 3) FROM student;

   OUTPUT: First 3 characters
   REAL: Extract part of a username/name


   LEFT()
   DEF: Returns characters from the left side

   INPUT: SELECT LEFT(name, 3) FROM student;

   OUTPUT: First 3 characters
   REAL: Get initials/prefix


   RIGHT()
   DEF: Returns characters from the right side

   INPUT: SELECT RIGHT(name, 3) FROM student;

   OUTPUT: Last 3 characters
   REAL: Get last digits/characters


   TRIM()
   DEF: Removes spaces from both sides

   INPUT: SELECT TRIM('  Anup  ');

   OUTPUT: Anup
   REAL: Clean extra spaces from user input


   REPLACE()
   DEF: Replaces part of a string with another string

   INPUT: SELECT REPLACE(address, 'Delhi', 'Noida')
          FROM student;

   OUTPUT: Delhi is replaced with Noida
   REAL: Replace or clean text data


   REVERSE()
   DEF: Reverses a string

   INPUT: SELECT REVERSE(name) FROM student;

   OUTPUT: puna
   REAL: String manipulation


   IMPORTANT:

   CONCAT()    → Combine strings
   UPPER()     → Uppercase
   LOWER()     → Lowercase
   LENGTH()    → String length
   SUBSTRING() → Extract part
   LEFT()      → Characters from left
   RIGHT()     → Characters from right

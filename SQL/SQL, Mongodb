   REAL: Add new customer
*/

/* =========================
   4. SELECT
   =========================
   DEF: Retrieve data
   WHEN: Reporting, searching
   WHERE: Analytics dashboards
   INPUT: SELECT * FROM student;
   OUTPUT: All rows
   REAL: Show all students
*/

/* =========================
   5. WHERE
   =========================
   DEF: Filter rows
   WHEN: Need specific subset
   WHERE: Targeted queries
   INPUT: SELECT * FROM student WHERE city='Delhi';
   OUTPUT: Only Delhi students
   REAL: Find customers in city
*/

/* =========================
   6. LOGICAL OPERATORS
   =========================
   DEF: Combine conditions (AND, OR, NOT)
   WHEN: Complex filters
   WHERE: Eligibility checks
   INPUT: SELECT * FROM student WHERE age>20 AND city='Delhi';
   OUTPUT: Rows matching both
   REAL: Eligible voters in Delhi
*/

/* =========================
   7. IN / BETWEEN / LIKE / REGEXP
   =========================
   DEF: Flexible filtering
   WHEN: Pattern or range search
   WHERE: Search modules
   INPUT: SELECT * FROM student WHERE age BETWEEN 20 AND 25;
   OUTPUT: Rows age 20–25
   REAL: Orders between two dates
*/

/* =========================
   8. ORDER BY / DISTINCT / LIMIT
   =========================
   DEF: Sort, deduplicate, restrict
   WHEN: Ranking, pagination
   WHERE: Reports, UI lists
   INPUT: SELECT DISTINCT city FROM student ORDER BY city ASC LIMIT 2;
   OUTPUT: Top 2 unique cities
   REAL: Top 10 products
*/

/* =========================
   9. NULL CHECK
   =========================
   DEF: Handle missing values
   WHEN: Data cleaning
   WHERE: Validation systems
   INPUT: SELECT * FROM student WHERE city IS NULL;
   OUTPUT: Rows with null city
   REAL: Find incomplete forms
*/

/* =========================
   10. AGGREGATE FUNCTIONS
   =========================
   DEF: Perform calculations on sets
   WHEN: Analytics
   WHERE: Reports, BI tools
   INPUT: SELECT AVG(age) FROM student;

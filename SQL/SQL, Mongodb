*/

/* =========================
   13. TRANSACTION (COMMIT/ROLLBACK)
   =========================
   DEF: Group queries atomically
   WHEN: Critical operations
   WHERE: Banking, e-commerce
   INPUT: START TRANSACTION; UPDATE...; ROLLBACK; COMMIT;
   OUTPUT: Changes saved/undone
   REAL: Money transfer safety
*/

/* =========================
   14. PRIMARY & FOREIGN KEY
   =========================
   DEF: Ensure relational integrity
   WHEN: Linking tables
   WHERE: Relational DB
   INPUT: FOREIGN KEY(sid) REFERENCES student(id);
   OUTPUT: Constraint applied
   REAL: Orders linked to customers
*/

/* =========================
   15. JOINS (INNER/LEFT/RIGHT/CROSS)
   =========================
   DEF: Combine rows from multiple tables
   WHEN: Need related data
   WHERE: Reporting
   INPUT: SELECT s.name,c.cname FROM student s INNER JOIN course c ON s.id=c.sid;
   OUTPUT: Student + course
   REAL: Student + enrolled course
*/

/* =========================
   16. GROUP BY + HAVING
   =========================
   DEF: Group rows, filter aggregates
   WHEN: Summaries
   WHERE: Analytics
   INPUT: SELECT city,COUNT(*) FROM student GROUP BY city HAVING COUNT(*)>1;
   OUTPUT: Cities with >1 student
   REAL: Customers per city
*/

/* =========================
   17. SUBQUERY
   =========================
   DEF: Query inside another query
   WHEN: Complex conditions
   WHERE: Nested logic
   INPUT: SELECT name FROM student WHERE age>(SELECT AVG(age) FROM student);

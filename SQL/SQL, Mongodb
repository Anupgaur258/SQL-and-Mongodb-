/* =========================
   1. CREATE DATABASE
   =========================
   DEF: Creates a new database container
   WHEN: Starting a new project/system
   WHERE: College DB, Bank DB
   INPUT: CREATE DATABASE college;
   OUTPUT: Query OK
   REAL: College → student/course tables
*/

/* =========================
   2. CREATE TABLE
   =========================
   DEF: Defines structure (columns + constraints)
   WHEN: Need to store entity data
   WHERE: Student, Employee, Product
   INPUT: CREATE TABLE student(id INT PRIMARY KEY, name VARCHAR(50));
   OUTPUT: Table created
   REAL: Student records in college
*/

/* =========================
   3. INSERT DATA
   =========================
   DEF: Add rows into table
   WHEN: Populate records
   WHERE: Any transactional system
